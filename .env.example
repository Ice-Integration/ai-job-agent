APP_ENV=development
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent@localhost:5432/jobagent
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_BYTES=5000000
JOB_SEARCH_LIMIT=50
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JOB_DISCOVERY_ENDPOINT=https://remotive.com/api/remote-jobs
JOB_DISCOVERY_QUERIES=python backend engineer,senior python backend,AI backend engineer,software engineer
JOB_DISCOVERY_LIMIT=20
JOB_DISCOVERY_INTERVAL_HOURS=6
